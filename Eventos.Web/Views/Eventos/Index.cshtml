@model IEnumerable<Eventos.Web.Models.Evento>
@{ ViewData["Title"]="Eventos"; }
<div class="page-head"><div><p class="eyebrow">AGENDA</p><h1>Eventos activos</h1></div><a class="btn btn-primary" asp-action="Create">Nuevo evento</a></div>
<form method="get" class="card-clean p-3 mb-4 d-flex gap-2"><select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias"><option value="">Todas las categorías</option></select><button class="btn btn-outline-secondary">Filtrar</button></form>
<div class="row g-3">@foreach(var e in Model){var inscritos=e.Inscripciones.Count;var cupos=e.Aforo-inscritos;<div class="col-md-6 col-lg-4"><article class="card-clean p-4 h-100"><p class="eyebrow">@e.Categoria?.Nombre</p><h4>@e.Titulo</h4><p class="text-muted">@e.Fecha.ToString("dd MMM · HH:mm") · @e.Lugar</p><span class="badge badge-soft rounded-pill">@e.Modalidad</span><div class="mt-4 d-flex justify-content-between"><span>@inscritos inscritos</span><strong>@cupos cupos</strong></div><div class="mt-3"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id">Ver</a> <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@e.Id">Editar</a></div></article></div>}</div>
