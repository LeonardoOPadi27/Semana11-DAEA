@model Eventos.Web.Models.Evento
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control"/></div><div class="col-md-6"><label asp-for="CategoriaId" class="form-label">Categoría</label><select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias"><option value="">Selecciona</option></select></div><div class="col-md-6"><label asp-for="Fecha" class="form-label">Fecha</label><input asp-for="Fecha" type="datetime-local" class="form-control"/></div><div class="col-md-6"><label asp-for="Lugar" class="form-label">Lugar</label><input asp-for="Lugar" class="form-control"/></div><div class="col-md-4"><label asp-for="Modalidad" class="form-label">Modalidad</label><select asp-for="Modalidad" class="form-select"><option>Presencial</option><option>Virtual</option></select></div><div class="col-md-4"><label asp-for="Aforo" class="form-label">Aforo</label><input asp-for="Aforo" class="form-control"/></div><div class="col-md-4"><label asp-for="Precio" class="form-label">Precio</label><input asp-for="Precio" class="form-control"/></div></div>
