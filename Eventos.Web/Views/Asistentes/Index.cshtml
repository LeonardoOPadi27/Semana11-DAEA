@model IEnumerable<Eventos.Web.Models.Asistente>
@{ViewData["Title"]="Asistentes";}<div class="page-head"><div><p class="eyebrow">COMUNIDAD</p><h1>Asistentes</h1></div><a class="btn btn-primary" asp-action="Create">Nuevo asistente</a></div><div class="card-clean table-responsive"><table class="table"><thead><tr><th>NOMBRES</th><th>DNI</th><th>CORREO</th><th>TELÉFONO</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Nombres</td><td>@a.Dni</td><td>@a.Correo</td><td>@a.Telefono</td></tr>}</tbody></table></div>
