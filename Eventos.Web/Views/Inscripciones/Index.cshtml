@model IEnumerable<Eventos.Web.Models.Inscripcion>
@{ViewData["Title"]="Inscripciones";}<div class="page-head"><div><p class="eyebrow">REGISTRO</p><h1>Inscripciones</h1></div><a class="btn btn-primary" asp-action="Create">Nueva inscripción</a></div><div class="card-clean table-responsive"><table class="table"><thead><tr><th>EVENTO</th><th>ASISTENTE</th><th>FECHA</th><th>ESTADO</th><th></th></tr></thead><tbody>@foreach(var i in Model){<tr><td>@i.Evento?.Titulo</td><td>@i.Asistente?.Nombres</td><td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge badge-soft rounded-pill">@i.Estado</span></td><td class="text-end">@if(i.Estado=="Confirmada"){<form method="post" asp-action="Cancelar" asp-route-id="@i.Id"><button class="btn btn-sm btn-outline-danger">Cancelar</button></form>}</td></tr>}</tbody></table></div>
