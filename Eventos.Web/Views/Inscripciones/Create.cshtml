@model Eventos.Web.Models.Inscripcion
@{ViewData["Title"]="Nueva inscripción";}<div class="page-head"><h1>Nueva inscripción</h1></div><div class="card-clean p-4"><form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="EventoId" class="form-label">Evento</label><select asp-for="EventoId" class="form-select" asp-items="ViewBag.Eventos"><option value="">Selecciona un evento</option></select></div><div class="col-md-6"><label asp-for="AsistenteId" class="form-label">Asistente</label><select asp-for="AsistenteId" class="form-select" asp-items="ViewBag.Asistentes"><option value="">Selecciona un asistente</option></select></div></div><div class="mt-4"><button class="btn btn-primary">Confirmar inscripción</button> <a class="btn btn-light" asp-action="Index">Cancelar</a></div></form></div>
